---
// Route for /admin that serves the Decap CMS panel
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>PumpCoin CMS</title>
    <script>window.CMS_MANUAL_INIT = true;</script>
    <script src="https://unpkg.com/decap-cms@^3.3.5/dist/decap-cms.js"></script>
    <style>
      html, body {
        height: 100%;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <!-- Decap CMS Admin Panel -->
    <script>
      CMS.init({
        config: '/admin/config.yml'
      });
    </script>
  </body>
</html>
