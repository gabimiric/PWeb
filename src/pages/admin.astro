<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>PumpCoin CMS</title>
    <script is:inline>window.CMS_MANUAL_INIT = true;</script>
    <script is:inline src="https://unpkg.com/decap-cms@^3.3.5/dist/decap-cms.js"></script>
    <style>
      html, body {
        height: 100%;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <script is:inline>
      const isLocalhost = ['localhost', '127.0.0.1', '0.0.0.0'].includes(window.location.hostname);
      const configUrl = isLocalhost ? '/config.local.yml' : '/config.yml';
      const link = document.createElement('link');
      link.setAttribute('rel', 'cms-config-url');
      link.setAttribute('type', 'text/yaml');
      link.setAttribute('href', configUrl);
      document.head.appendChild(link);

      CMS.init();
    </script>
  </body>
</html>
