---
interface Props {
  name: string;
  role: string;
  bio: string;
  image?: string;
}

const { name, role, bio, image } = Astro.props;
---

<article class="team-member">
  {image && (
    <div class="member-photo">
      <img src={image} alt={name} />
    </div>
  )}
  <h3>{name}</h3>
  <p class="role">{role}</p>
  <p class="bio">{bio}</p>
</article>
